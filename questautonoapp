def inject_ghost_quest(game_name, package_name, target_game_id, achs_list):
  show_header()
  print(f"{Y}👤 Gamer Tag   : {W}{g}{NC}")
  print(f"{Y}📧 Linked Mail : {W}{e}{NC}")
  print(f"{C}──────────────────────────────────────────────{NC}")
  print(
      f"{C}👻 Ghost Injecting: {W}{game_name} {Y}(App Not Required!){NC}..."
  )

  conn = sqlite3.connect(active_db)
  cursor = conn.cursor()
  now = int(subprocess.check_output("date +%s%3N", shell=True))

  # ১. প্যাকেজ রেজিস্ট্রি চেক বা ফিক্সড UID দিয়ে ইনসার্ট
  cc_row = cursor.execute(
      "SELECT _id FROM client_contexts WHERE package_name = ? LIMIT 1",
      (package_name,),
  ).fetchone()
  if cc_row:
    real_cc_id = cc_row[0]
  else:
    # নিরাপত্তা বাইপাস করতে package_uid এ একটি রেন্ডম সংখ্যা (যেমন 10000+) বসানো হলো
    dummy_uid = random.randint(10000, 30000)
    try:
      cursor.execute(
          """
                INSERT INTO client_contexts (package_name, account_name, package_uid) 
                VALUES (?, ?, ?)
            """,
          (package_name, e, dummy_uid),
      )
    except:
      # যদি package_uid কলাম না থাকে তবে শুধু নরমাল ইনসার্ট
      cursor.execute(
          """
                INSERT INTO client_contexts (package_name, account_name) 
                VALUES (?, ?)
            """,
          (package_name, e),
      )
    real_cc_id = cursor.lastrowid

  # ২. আনলকড কুয়েস্ট ইনজেকশন
  for a_id, a_name, steps in achs_list:
    cursor.execute(
        """
            INSERT OR REPLACE INTO achievement_instances 
            (definition_id, player_id, state, current_steps, formatted_current_steps, last_updated_timestamp, instance_xp_value)
            VALUES (?, ?, 0, ?, '', ?, 1000)
        """,
        (a_id, player_id, steps, now),
    )

    cursor.execute(
        """
            INSERT OR REPLACE INTO achievement_pending_ops 
            (client_context_id, external_achievement_id, achievement_type, new_state, steps_to_increment, min_steps_to_set, external_game_id, external_player_id)
            VALUES (?, ?, 0, 0, ?, ?, ?, ?)
        """,
        (real_cc_id, a_id, steps, steps, str(target_game_id), player_id),
    )

  conn.commit()
  conn.close()

  # ৩. গুগল ক্লাউড সার্ভার ফোর্স সিঙ্ক
  subprocess.run(
      "su -c '/system/bin/am broadcast -a com.google.android.gms.games.SYNC"
      " --user 0'",
      shell=True,
      capture_output=True,
  )
  subprocess.run(
      "su -c '/system/bin/am force-stop com.google.android.gms'",
      shell=True,
      capture_output=True,
  )
  subprocess.run(
      "su -c '/system/bin/am force-stop com.google.android.play.games'",
      shell=True,
      capture_output=True,
  )

  print(f"{G}✔ Ghost Injected & Google Cloud Sync Dispatched!{NC}")
  print(
      f"\n{Y}🎯 Target Game : {W}{game_name} {Y}[{G}Ghost Quest Claimed{Y}]{NC}"
  )

  print(f"{C}┌────────────────────────────────┬───────────┐{NC}")
  print(f"{C}│ Target Quest Achievement       │ Status    │{NC}")
  print(f"{C}├────────────────────────────────┼───────────┤{NC}")
  for a_id, a_name, steps in achs_list:
    print(f"│ {W}{a_name:<30}{NC} │ {G}COMPLETED{NC} │")
  print(f"{C}└────────────────────────────────┴───────────┘{NC}")

  calc_time = round(random.uniform(1.85, 2.95), 2)
  print(f"\n{Y}⏱ Ghost Speed    : {G}{calc_time}s (Instant Fast){NC}")

  print(f"\n{G}┌──────────────────────────────────────────────┐{NC}")
  print(f"{W}│  ★ SUCCESS: {game_name:<18} Completed!  │{NC}")
  print(f"{Y}│  👉 Directly Open Play Store & Claim Points! │{NC}")
  print(f"{M}│  ♥ 100% No-App Ghost Technology Activated!   │{NC}")
  print(f"{G}└──────────────────────────────────────────────┘{NC}\n")
